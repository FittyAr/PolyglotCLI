<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Multi-targeting móvil desactivado por ahora: NETSDK1147
             (workloads android/ios/maccatalyst no instalados) bloquea
             el build entero. Solo dejamos el target de Windows.
             Para reactivar mobile hay que (1) descomentar las líneas
             siguientes y (2) restaurar las carpetas Platforms/Android,
             Platforms/iOS y Platforms/MacCatalyst desde el historial de
             git (se eliminaron al preparar la publicación en Microsoft
             Store; existen en el commit 3f4be21 y anteriores; ver
             docs/STORE_SUBMISSION.md o usar git checkout sobre esa ruta).
        <TargetFrameworks>net11.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
        -->
        <TargetFrameworks>net11.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>PolyglotCLI.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Icono Win32 embebido en PolyglotCLI.Maui.exe.
             Es la fuente de verdad para los iconos de los accesos directos
             (Escritorio y Menu Inicio) y para el icono del desinstalador en
             Panel de control (vía Inno Setup UninstallDisplayIcon). -->
        <ApplicationIcon>..\assets\icons\app.ico</ApplicationIcon>

        <!-- Generación de código XAML en compilación (más rápido que inflar en runtime). -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Nombre visible -->
        <ApplicationTitle>PolyglotCLI</ApplicationTitle>

        <!-- Identificador de la aplicación -->
        <ApplicationId>com.fittyar.polyglotcli</ApplicationId>

        <!-- Versiones: $(Version) viene de Directory.Build.props (raíz del
             repo) y es la misma para web y escritorio. ApplicationVersion
             debe ser un entero; no se usa en Windows sin empaquetar. -->
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- La app se publica sin empaquetar (exe + carpeta). El MSIX para
             Microsoft Store se arma aparte en .github/workflows/release.yml
             con assets/msix/AppxManifest.xml (ver docs/STORE_SUBMISSION.md). -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Icono de la app (ventana / barra de tareas) generado a partir del
             arte de marca (assets/brand). Fondo transparente. -->
        <MauiIcon Include="Resources\AppIcon\appicon.png" />

        <!-- Splash Screen (solo plataformas que lo usan; Windows sin
             empaquetar no lo muestra). -->
        <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0F172A" BaseSize="128,128" />
    </ItemGroup>

    <!--
      Build para Microsoft Store (MSIX). Solo se activa con -p:PolyglotMsix=true
      (ver .github/workflows/release.yml). El paquete MSIX necesita UN único
      resources.pri en la raíz cuyo índice se llame igual que la identidad del
      paquete: WinUI/MRT Core lo usa para resolver ms-appx:///...xbf y el shell
      de Windows para los logos del manifiesto. Por eso:
        - se agregan los logos de assets/msix/Assets como contenido (Assets\*),
          para que el generador de PRI los indexe con sus calificadores
          scale-XXX / targetsize-XX;
        - el workflow pasa además ProjectPriFileName=resources.pri y
          ProjectPriIndexName=<Identity Name de Partner Center>.
      Un resources.pri generado aparte solo con los logos (makepri sobre
      Assets\) ocultaría el PRI de la app y WinUI no arrancaría.
    -->
    <ItemGroup Condition="'$(PolyglotMsix)' == 'true'">
        <Content Include="..\assets\msix\Assets\*.png" Link="Assets\%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <!--
      Único archivo que el AboutConfigTab sirve localmente: LICENSE.
      El README y los diagramas se enlazan directamente a GitHub para
      que los cambios se vean sin rebuild. El target SyncDocs (más
      abajo) mantiene la copia de LICENSE fresca antes de cada build.
    -->

    <Target Name="SyncDocs" BeforeTargets="BeforeBuild">
        <Exec Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\sync-docs.ps1&quot;"
              Condition="Exists('$(MSBuildThisFileDirectory)..\scripts\sync-docs.ps1')"
              ContinueOnError="true" />
    </Target>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui" Version="17.0.0" />
        <PackageReference Include="BlazorPanzoom" Version="0.2.1" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
        <PackageReference Include="Radzen.Blazor" Version="13.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PolyglotCLI.core\PolyglotCLI.core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Enlace de archivos de componentes de la aplicación Web para compilación directa en MAUI -->
        <Compile Include="..\PolyglotCLI.web\Components\**\*.cs" LinkBase="Components" />
        <Compile Include="..\PolyglotCLI.web\Services\JobDetails\**\*.cs" LinkBase="Services\JobDetails" />
        <Compile Include="..\PolyglotCLI.web\Services\UpdateHostedService.cs" Link="Services\UpdateHostedService.cs" />
        <Compile Include="..\PolyglotCLI.web\TranslationSession.cs" Link="TranslationSession.cs" />
        <RazorComponent Include="..\PolyglotCLI.web\Components\**\*.razor" Exclude="..\PolyglotCLI.web\Components\App.razor;..\PolyglotCLI.web\Components\Pages\Error.razor" LinkBase="Components" />
        <None Include="..\PolyglotCLI.web\Components\**\*.razor.css" Exclude="..\PolyglotCLI.web\Components\App.razor.css" LinkBase="Components" />
    </ItemGroup>

</Project>
