<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PolyglotCLI.core\PolyglotCLI.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorPanzoom" Version="0.2.1" />
    <PackageReference Include="Radzen.Blazor" Version="11.1.7" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <AssemblyName>PolyglotCLI</AssemblyName>
    <Version>1.1.2</Version>
    <!-- Icono Win32 embebido en PolyglotCLI.exe (apphost del servidor web).
         Es la fuente de verdad para los iconos de los accesos directos
         (Escritorio y Menu Inicio). -->
    <ApplicationIcon>..\assets\icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\assets\icons\app.ico" Link="wwwroot\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Único archivo que el AboutConfigTab sirve localmente: LICENSE.
      El README y los diagramas se enlazan directamente a GitHub para
      que los cambios se vean sin rebuild. El target SyncDocs (más
      abajo) mantiene la copia de LICENSE fresca antes de cada build.
    -->
  </ItemGroup>

  <!--
    Antes de compilar, sincroniza ../docs, ../README.md y ../LICENSE
    hacia wwwroot/. Es idempotente (solo sobreescribe), rápido
    (archivos pequeños), y garantiza que el static file middleware
    pueda servir los hrefs del AboutConfigTab sin que el repo quede
    con archivos desactualizados.
  -->
  <Target Name="SyncDocs" BeforeTargets="BeforeBuild">
    <Exec Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\sync-docs.ps1&quot;"
          Condition="Exists('$(MSBuildThisFileDirectory)..\scripts\sync-docs.ps1')"
          ContinueOnError="true" />
  </Target>

</Project>




















