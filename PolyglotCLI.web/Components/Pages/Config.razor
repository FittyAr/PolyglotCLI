@page "/config"
@using PolyglotCLI.web.Components.Config

<PageTitle>Configuración - PolyglotCLI</PageTitle>

<RadzenCard class="rz-my-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Configuración de la Aplicación</RadzenText>

    @* Avisos globales (vivos arriba de las pestañas, no atados a
       la pestaña "Acerca de"). Cada uno tiene su X: cerrarlo
       persiste el flag correspondiente en config.json para que
       no vuelva a salir en próximos arranques. *@
    @if (AppConfig?.LastMigrationUtc is DateTime migrationUtc && !AppConfig.DismissedMigrationNotice)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="true" Close="@DismissMigrationNotice"
                     Variant="Variant.Flat" Icon="history" class="rz-mb-3" style="font-size: 0.85rem;">
            <strong>Migración reciente</strong> (@migrationUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") local).
            Se movieron los datos de la app desde el árbol legacy
            (<code>%AppData%\PolyglotCLI\</code>) al nuevo
            (<code>%AppData%\FittyAr\PolyglotCLI\</code>).
            <strong>El config.json anterior fue descartado por seguridad</strong>:
            si tenías API keys guardadas, tenés que re-ingresarlas desde la pestaña
            <em>General</em>. Los logs, el historial de jobs y los prompts editados
            sí se migraron.
        </RadzenAlert>
    }
    @if (AppConfig is not null && !AppConfig.DismissedDpapiNotice)
    {
        <RadzenAlert AlertStyle="AlertStyle.Light" AllowClose="true" Close="@DismissDpapiNotice"
                     Variant="Variant.Flat" Icon="lock" class="rz-mb-3" style="font-size: 0.85rem;">
            Las API keys dentro de <code>config.json</code> se guardan cifradas con
            <strong>DPAPI</strong> (Windows, scope del usuario actual). Si copias el
            archivo a otra máquina o usuario, las keys no se podrán descifrar.
        </RadzenAlert>
    }

    <RadzenTemplateForm Data="@AppConfig" Submit="@(async (PolyglotCLI.AppConfig args) => await SaveConfig(args))">
        <RadzenTabs>
            <Tabs>
                <!-- Pestaña 1: General -->
                <RadzenTabsItem Text="General" Icon="settings">
                    <GeneralConfigTab @ref="generalTabRef"
                                      AppConfig="@AppConfig"
                                      IsTestingConnection="@isTestingConnection"
                                      OnTestConnection="@TestConnection" />
                </RadzenTabsItem>

                <!-- Pestaña 2: Avanzado -->
                <RadzenTabsItem Text="Avanzado" Icon="tune">
                    <AdvancedConfigTab AppConfig="@AppConfig" />
                </RadzenTabsItem>

                <!-- Pestaña 3: OCR Process -->
                <RadzenTabsItem Text="OCR Process" Icon="visibility">
                    <OcrConfigTab AppConfig="@AppConfig" AvailableModels="@availableModels" IsTestingConnection="@isTestingConnection" OnLoadModels="@LoadModelsFromServer" />
                </RadzenTabsItem>

                <!-- Pestaña 3: Translation -->
                <RadzenTabsItem Text="Translation" Icon="translate">
                    <TranslationConfigTab AppConfig="@AppConfig" AvailableModels="@availableModels" IsTestingConnection="@isTestingConnection" OnLoadModels="@LoadModelsFromServer" />
                </RadzenTabsItem>

                <!-- Pestaña 4: Revision -->
                <RadzenTabsItem Text="Revision" Icon="rate_review">
                    <RevisionConfigTab AppConfig="@AppConfig" AvailableModels="@availableModels" IsTestingConnection="@isTestingConnection" OnLoadModels="@LoadModelsFromServer" />
                </RadzenTabsItem>

                <!-- Pestaña 5: Output Formats -->
                <RadzenTabsItem Text="Output Formats" Icon="rule">
                    <OutputConfigTab AppConfig="@AppConfig" OutputFormatOptions="@outputFormatOptions" @bind-OutputFormatsInput="outputFormatsInput" @bind-InputExtensionsInput="inputExtensionsInput" />
                </RadzenTabsItem>

                <!-- Pestaña 6: Prompts del Sistema -->
                <RadzenTabsItem Text="Prompts del Sistema" Icon="description">
                    <PromptsConfigTab @bind-OcrPromptText="ocrPromptText" @bind-TranslationPromptText="translationPromptText" @bind-ReviewPromptText="reviewPromptText" @bind-PromptImproverPromptText="promptImproverPromptText" />
                </RadzenTabsItem>

                <!-- Pestaña 7: Acerca de -->
                <RadzenTabsItem Text="Acerca de" Icon="info">
                    <AboutConfigTab />
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>

        <RadzenRow class="rz-mt-6">
            <RadzenColumn Size="12" class="rz-text-align-right">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Guardar Configuración" Icon="save" ButtonStyle="ButtonStyle.Primary" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenTemplateForm>
</RadzenCard>

@if(!string.IsNullOrEmpty(saveMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false" class="rz-mt-4">
        @saveMessage
    </RadzenAlert>
}
