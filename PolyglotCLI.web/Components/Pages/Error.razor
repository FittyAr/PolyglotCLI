@page "/Error"
@using System.Diagnostics

<PageTitle>@L["Common.Error"]</PageTitle>

<h1 class="text-danger">@L["Errors.Heading"]</h1>
<h2 class="text-danger">@L["Errors.RequestFailed"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["Errors.RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["Errors.DevModeHeading"]</h3>
<p>
    @L["Errors.DevModeSwapPrefix"] <strong>Development</strong> @L["Errors.DevModeSwapSuffix"]
</p>
<p>
    <strong>@L["Errors.DevModeWarning"]</strong>
    @L["Errors.DevModeWarningDetail"]
    @L["Errors.DevModeEnablePrefix"] <strong>Development</strong> @L["Errors.DevModeEnableVariable"] <strong>ASPNETCORE_ENVIRONMENT</strong> @L["Errors.DevModeEnableValue"] <strong>Development</strong>
    @L["Errors.DevModeEnableSuffix"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
