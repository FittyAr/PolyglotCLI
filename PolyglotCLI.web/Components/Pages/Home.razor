@page "/"

<PageTitle>@L["Home.PageTitle"]</PageTitle>

<RadzenRow>
    @if (!isConsoleExpanded)
    {
        <RadzenColumn SizeMD="7" SizeLG="8">
            <RadzenCard class="rz-mb-4">

                <RadzenTemplateForm Data="@options"
                    Submit="@(async (CommandLineOptions args) => await RunTranslation(args))">

                    <!-- Explorador de carpetas y discos -->
                    <RadzenCard class="rz-mb-4 rz-p-4"
                        style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2" style="font-weight: bold;">@L["Home.FolderExplorer"]</RadzenText>
                        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                            @if (drives.Count > 0)
                            {
                                <RadzenColumn Size="3">
                                    <RadzenLabel Text="@L["Home.Drive"]" class="rz-mb-1" style="font-size: 0.85rem;" />
                                    <RadzenDropDown @bind-Value="selectedDrive" Data="@drives" Change="@ChangeDrive"
                                        class="rz-w-100" />
                                </RadzenColumn>
                            }
                            <RadzenColumn Size="@(drives.Count > 0 ? 9 : 12)">
                                <RadzenLabel Text="@L["Home.DirectoryPath"]" class="rz-mb-1" style="font-size: 0.85rem;" />
                                <div style="display: flex; gap: 0.5rem;">
                                    <RadzenTextBox @bind-Value="currentDirectory" style="flex-grow: 1;" />
                                    <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                                        Click="@(() => LoadDirectory(currentDirectory))" Tooltip="@L["Home.LoadDirectory"]" />
                                </div>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenCard>

                    <!-- Grid de selección y configuración por archivo -->
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2" style="font-weight: bold;">@L["Home.FileSelectionHeader"]</RadzenText>
                    @if (fileSystemItems.Count > 0)
                    {
                        <RadzenDataGrid Data="@fileSystemItems" TItem="FileSystemItem"
                            SelectionMode="DataGridSelectionMode.Single" @bind-Value="@selectedRows" AllowFiltering="false"
                            AllowSorting="false" PageSize="100" class="rz-mb-4" Style="max-height: 400px; overflow-y: auto;">
                            <Columns>
                                <!-- Selección -->
                                <RadzenDataGridColumn TItem="FileSystemItem" Width="55px" Sortable="false" Filterable="false"
                                    TextAlign="TextAlign.Center">
                                    <HeaderTemplate>
                                        <RadzenCheckBox Value="@allSelected" TValue="bool"
                                            Change="@(val => SelectAllFiles(val))" />
                                    </HeaderTemplate>
                                    <Template Context="item">
                                        @if (!item.IsDirectory)
                                        {
                                            <RadzenCheckBox @bind-Value="item.IsSelected" />
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <!-- Nombre -->
                                <RadzenDataGridColumn TItem="FileSystemItem" Title="@L["Home.ColumnName"]" Width="260px">
                                    <Template Context="item">
                                        @if (item.IsDirectory)
                                        {
                                            <span @onclick="@(() => LoadDirectory(item.FullPath))"
                                                style="cursor: pointer; font-weight: bold; color: #64b5f6; display: inline-flex; align-items: center;">
                                                <RadzenIcon Icon="folder"
                                                    Style="margin-right: 8px; color: #ffca28; vertical-align: middle;" />
                                                @item.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="display: inline-flex; align-items: center;">
                                                <RadzenIcon Icon="insert_drive_file"
                                                    Style="margin-right: 8px; color: #90a4ae; vertical-align: middle;" />
                                                @item.Name
                                            </span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <!-- Tipo -->
                                <RadzenDataGridColumn TItem="FileSystemItem" Title="@L["Home.ColumnType"]" Width="80px">
                                    <Template Context="item">
                                        @(item.IsDirectory ? "<DIR>" : item.Extension.ToUpperInvariant())
                                    </Template>
                                </RadzenDataGridColumn>

                                <!-- Método (sólo PDF) -->
                                <RadzenDataGridColumn TItem="FileSystemItem" Title="@L["Home.ColumnMethod"]" Width="150px">
                                    <Template Context="item">
                                        @if (!item.IsDirectory)
                                        {
                                            @if (item.Extension.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <RadzenSelectBar @bind-Value="item.Mode" Size="ButtonSize.Small" TValue="string"
                                                    style="font-size: 0.8rem;">
                                                    <Items>
                                                        <RadzenSelectBarItem Value="@("text")" Text="@L["Home.ModeText"]" />
                                                        <RadzenSelectBarItem Value="@("image")" Text="@L["Home.ModeImage"]" />
                                                    </Items>
                                                </RadzenSelectBar>
                                            }
                                            else
                                            {
                                                <span style="font-size: 0.85rem; color: #b0bec5;">@(item.Mode == "image" ? L["Home.ModeImage"] :
                                    L["Home.ModeText"])</span>
                                            }
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <!-- Rango Páginas (sólo PDF) -->
                                <RadzenDataGridColumn TItem="FileSystemItem" Title="@L["Home.ColumnPages"]" Width="110px">
                                    <Template Context="item">
                                        @if (!item.IsDirectory)
                                        {
                                            @if (item.Extension.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <RadzenTextBox @bind-Value="item.PageRange"
                                                    Style="width: 100%; height: 28px; font-size: 0.85rem;" Placeholder="@L["Home.PagesAllPlaceholder"]" />
                                            }
                                            else
                                            {
                                                <span style="font-size: 0.85rem; color: #b0bec5;">-</span>
                                            }
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                    else
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="rz-mb-4">
                            @L["Home.NoFilesInDirectory"]
                        </RadzenAlert>
                    }

                    <RadzenRow Gap="1rem" class="rz-mb-4">
                        <RadzenColumn Size="6">
                            <RadzenLabel Text="@L["Home.TargetLanguage"]" class="rz-mb-2" />
                            <RadzenTextBox @bind-Value="options.TargetLanguage" class="rz-w-100" />
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenLabel Text="@L["Home.OutputFormat"]" class="rz-mb-2" />
                            <RadzenDropDown @bind-Value="options.SelectedFormat" Data="@Config.SupportedOutputFormats"
                                class="rz-w-100" Placeholder="@L["Home.OutputFormatNone"]" AllowClear="true" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="1rem" class="rz-mb-4">
                        <RadzenColumn Size="4" class="rz-align-self-center">
                            <RadzenCheckBox @bind-Value="options.Transcribe" Name="optTranscribe" />
                            <RadzenLabel Text="@L["Home.ExtractTextOcr"]" Component="optTranscribe" class="rz-ml-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="4" class="rz-align-self-center">
                            <RadzenCheckBox @bind-Value="options.Translate" Name="optTranslate" />
                            <RadzenLabel Text="@L["Home.TranslateContent"]" Component="optTranslate" class="rz-ml-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="4" class="rz-align-self-center">
                            <RadzenCheckBox @bind-Value="options.Debug" Name="optDebug" />
                            <RadzenLabel Text="@L["Home.TestMode"]" Component="optDebug" class="rz-ml-2" />
                        </RadzenColumn>
                    </RadzenRow>

                    <!-- Prompt personalizado e IA -->
                    <RadzenCard class="rz-mb-4 rz-p-4"
                        style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2" style="font-weight: bold;">@L["Home.AdditionalPromptHeader"]</RadzenText>
                        <RadzenRow class="rz-mb-3">
                            <RadzenColumn Size="12">
                                <RadzenTextArea @bind-Value="options.AdditionalPrompt" Rows="5" class="rz-w-100"
                                    Placeholder="@L["Home.AdditionalPromptPlaceholder"]" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow>
                            <RadzenColumn Size="12">
                                <RadzenButton Text="@L["Home.AnalyzeFile"]" Icon="analytics" ButtonStyle="ButtonStyle.Info"
                                    Click="@(async () => await AnalyzeFilePrompt())"
                                    Disabled="@(isProcessing || selectedRows.Count != 1 || selectedRows[0].IsDirectory)" />

                                <RadzenButton Text="@L["Home.ImprovePrompt"]" Icon="upgrade" ButtonStyle="ButtonStyle.Secondary"
                                    Click="@(async () => await ImprovePrompt())"
                                    Disabled="@(isProcessing || string.IsNullOrWhiteSpace(options.AdditionalPrompt))"
                                    class="rz-ml-2" />

                                <RadzenButton Text="@L["Home.SavePresets"]" Icon="save" ButtonStyle="ButtonStyle.Warning"
                                    Click="@(async () => await SavePresets())" Disabled="@isProcessing" class="rz-ml-2" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenCard>

                    <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Home.StartTranslation"]" Icon="play_arrow"
                        ButtonStyle="ButtonStyle.Primary" BusyText="@L["Home.Processing"]" IsBusy="@isProcessing" class="rz-mt-2" />
                    @if (isProcessing)
                    {
                        <RadzenButton Text="@L["Home.StopProcess"]" Icon="stop" ButtonStyle="ButtonStyle.Danger" Click="@CancelProcess"
                            class="rz-mt-2 rz-ml-2" />
                    }
                </RadzenTemplateForm>
            </RadzenCard>
        </RadzenColumn>
    }

    <RadzenColumn SizeMD="@(isConsoleExpanded ? 12 : 5)" SizeLG="@(isConsoleExpanded ? 12 : 4)">
        <RadzenCard class="rz-h-100" style="display: flex; flex-direction: column; min-height: 500px;">
            <div class="app-brand-wrapper">
                <img src="brand-logo.png" alt="PolyglotCLI" class="app-brand-logo" />
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;" class="rz-mb-4">
                <RadzenText TextStyle="TextStyle.H6" style="margin: 0;">@L["Home.ProgressConsole"]</RadzenText>
                <div>
                    <RadzenButton Icon="@(isAutoscrollEnabled ? "arrow_downward" : "remove")"
                        ButtonStyle="@(isAutoscrollEnabled ? ButtonStyle.Success : ButtonStyle.Secondary)"
                        Size="ButtonSize.Small" Click="@ToggleAutoscroll"
                        Tooltip="@(isAutoscrollEnabled ? L["Home.DisableAutoscroll"] : L["Home.EnableAutoscroll"])" />

                    <RadzenButton Icon="@(isConsoleExpanded ? "fullscreen_exit" : "fullscreen")"
                        ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="@ToggleConsoleExpansion"
                        Tooltip="@(isConsoleExpanded ? L["Home.RestoreSize"] : L["Home.MaximizeConsole"])" class="rz-ml-2" />
                </div>
            </div>

            <div class="virtual-console flex-grow-1" id="consoleOutput"
                style="@(isConsoleExpanded ? "max-height: 800px; height: 600px;" : "")">
                @foreach (var log in logs)
                {
                    <div class="@log.CssClass">@log.Message</div>
                }
                @if (logs.Count == 0)
                {
                    <div class="log-debug">@L["Home.WaitingToStart"]</div>
                }
            </div>

        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
