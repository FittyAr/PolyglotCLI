@inherits LayoutComponentBase
@implements IDisposable
@inject PolyglotCLI.ApplicationMode AppMode
@inject NavigationManager Nav

<RadzenLayout style="min-height: 100vh">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.Center"
                     Gap="0.5rem"
                     class="rz-px-3">
            <RadzenButton Text="Traductor" Icon="translate" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => Nav.NavigateTo("/"))"
                          class="@(IsActive("/") ? "header-nav-btn header-nav-btn--active" : "header-nav-btn")" />
            <RadzenButton Text="Historial de Trabajos" Icon="history" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => Nav.NavigateTo("/history"))"
                          class="@(IsActive("/history") ? "header-nav-btn header-nav-btn--active" : "header-nav-btn")" />
            <RadzenButton Text="Configuración" Icon="settings" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => Nav.NavigateTo("/config"))"
                          class="@(IsActive("/config") ? "header-nav-btn header-nav-btn--active" : "header-nav-btn")" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenBody>
        <div class="p-4">
            @Body
        </div>
    </RadzenBody>

    @* Componente "fantasma" que escucha el servicio de auto-update y
        muestra un dialog con el aviso cuando hay una versión nueva.
        No renderiza nada visible. *@
    <UpdateNotifier />

    @if (AppMode.IsWebMode)
    {
        <RadzenFooter>
            <div class="footer-line">
                <span class="footer-credit">PolyglotCLI © 2026 FittyAr</span>
                <span class="footer-love" title="Si te resulta útil, considerá dejar una estrella en GitHub">
                    Hecho con <span class="footer-heart" aria-hidden="true">♥</span> para la comunidad de traducción
                </span>
            </div>
        </RadzenFooter>
    }
</RadzenLayout>

<RadzenComponents />
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

@code {
    private string currentPath = "/";

    protected override void OnInitialized()
    {
        currentPath = new Uri(Nav.Uri).AbsolutePath;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentPath = new Uri(e.Location).AbsolutePath;
        InvokeAsync(StateHasChanged);
    }

    private bool IsActive(string path) =>
        string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
