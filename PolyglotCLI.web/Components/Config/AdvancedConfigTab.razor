@using PolyglotCLI

@*
    Pestaña "Avanzado": agrupa timeouts, logs y toggles de módulos.
    Los timeouts se ocultan en proveedores cloud (OpenAI, Gemini, Qwen,
    Kimi, MiniMax, ...) porque la latencia la gestiona el proveedor y
    estos valores pierden utilidad práctica.
*@

<RadzenFieldset Text="@L["Config.RequestTimeouts"]" class="rz-mt-2">
    @if (IsCloudProvider)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Variant="Variant.Flat" Shade="Shade.Default" Icon="cloud">
            <strong>@L["Config.CloudTimeoutsLocal"]</strong> @L["Config.CloudTimeoutsMiddle"] <strong>@L["Config.CloudTimeoutsCloud"]</strong>
            @L["Config.CloudTimeoutsAfter"]
        </RadzenAlert>
    }
    else
    {
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="6">
                <RadzenLabel Text="@L["Config.ModelCheckTimeout"]" class="rz-mb-2" />
                <RadzenNumeric @bind-Value="AppConfig.ModelCheckTimeoutSeconds" TValue="int" class="rz-w-100" />
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenLabel Text="@L["Config.PromptImproveTimeout"]" class="rz-mb-2" />
                <RadzenNumeric @bind-Value="AppConfig.PromptImproveTimeoutSeconds" TValue="int" class="rz-w-100" />
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenFieldset>

<RadzenFieldset Text="@L["Config.LogSettings"]" class="rz-mt-4">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="4">
            <RadzenLabel Text="@L["Config.LogDirectory"]" class="rz-mb-2" />
            <RadzenTextBox @bind-Value="AppConfig.LogDirectory" class="rz-w-100" />
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenLabel Text="@L["Config.LogLevelConsole"]" class="rz-mb-2" />
            <RadzenTextBox @bind-Value="AppConfig.LogLevelConsole" class="rz-w-100" />
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenLabel Text="@L["Config.LogLevelFile"]" class="rz-mb-2" />
            <RadzenTextBox @bind-Value="AppConfig.LogLevelFile" class="rz-w-100" />
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

<RadzenFieldset Text="@L["Config.ActiveModules"]" class="rz-mt-4">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="3">
            <RadzenCheckBox @bind-Value="AppConfig.ModuleExtractionEnabled" Name="modExtract" />
            <RadzenLabel Text="@L["Config.ModuleExtraction"]" Component="modExtract" class="rz-ml-2" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenCheckBox @bind-Value="AppConfig.ModuleTranslationEnabled" Name="modTranslate" />
            <RadzenLabel Text="@L["Config.ModuleTranslation"]" Component="modTranslate" class="rz-ml-2" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenCheckBox @bind-Value="AppConfig.ModuleReviewEnabled" Name="modReview" />
            <RadzenLabel Text="@L["Config.ModuleReview"]" Component="modReview" class="rz-ml-2" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenCheckBox @bind-Value="AppConfig.ModuleConversionEnabled" Name="modConvert" />
            <RadzenLabel Text="@L["Config.ModuleConversion"]" Component="modConvert" class="rz-ml-2" />
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

@code {
    [Parameter]
    public AppConfig AppConfig { get; set; } = default!;

    /// <summary>
    /// True si el proveedor actual requiere API Key (modelo cloud).
    /// En ese caso los timeouts locales se ocultan porque la latencia
    /// la gestiona el proveedor.
    /// </summary>
    private bool IsCloudProvider =>
        LlmProviderHelper.RequiresApiKey(LlmProviderHelper.ParseProvider(AppConfig.Provider));
}
