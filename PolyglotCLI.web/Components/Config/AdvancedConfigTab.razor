@using PolyglotCLI

@*
    Pestaña "Avanzado": agrupa timeouts, logs y toggles de módulos.
    Los timeouts se ocultan en proveedores cloud (OpenAI, Gemini, Qwen,
    Kimi, MiniMax, ...) porque la latencia la gestiona el proveedor y
    estos valores pierden utilidad práctica.
*@

<RadzenFieldset Text="Timeouts de Solicitudes" class="rz-mt-2">
    @if (IsCloudProvider)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Variant="Variant.Flat" Shade="Shade.Default" Icon="cloud">
            Los <strong>timeouts locales</strong> no aplican para modelos <strong>cloud</strong>
            (OpenAI, Gemini, Qwen, Kimi, MiniMax, etc.). La latencia y los límites los gestiona el proveedor.
        </RadzenAlert>
    }
    else
    {
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="6">
                <RadzenLabel Text="Model Check Timeout (segundos)" class="rz-mb-2" />
                <RadzenNumeric @bind-Value="AppConfig.ModelCheckTimeoutSeconds" TValue="int" class="rz-w-100" />
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenLabel Text="Timeout Mejora Prompt (segundos)" class="rz-mb-2" />
                <RadzenNumeric @bind-Value="AppConfig.PromptImproveTimeoutSeconds" TValue="int" class="rz-w-100" />
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenFieldset>

<RadzenFieldset Text="Configuración de Logs" class="rz-mt-4">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="4">
            <RadzenLabel Text="Directorio de Logs" class="rz-mb-2" />
            <RadzenTextBox @bind-Value="AppConfig.LogDirectory" class="rz-w-100" />
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenLabel Text="Nivel Log Consola" class="rz-mb-2" />
            <RadzenTextBox @bind-Value="AppConfig.LogLevelConsole" class="rz-w-100" />
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenLabel Text="Nivel Log Archivo" class="rz-mb-2" />
            <RadzenTextBox @bind-Value="AppConfig.LogLevelFile" class="rz-w-100" />
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

<RadzenFieldset Text="Módulos Activos de la Traducción" class="rz-mt-4">
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="3">
            <RadzenCheckBox @bind-Value="AppConfig.ModuleExtractionEnabled" Name="modExtract" />
            <RadzenLabel Text="Extracción / OCR" Component="modExtract" class="rz-ml-2" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenCheckBox @bind-Value="AppConfig.ModuleTranslationEnabled" Name="modTranslate" />
            <RadzenLabel Text="Traducción" Component="modTranslate" class="rz-ml-2" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenCheckBox @bind-Value="AppConfig.ModuleReviewEnabled" Name="modReview" />
            <RadzenLabel Text="Revisión (Review)" Component="modReview" class="rz-ml-2" />
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenCheckBox @bind-Value="AppConfig.ModuleConversionEnabled" Name="modConvert" />
            <RadzenLabel Text="Conversión de Formatos" Component="modConvert" class="rz-ml-2" />
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

@code {
    [Parameter]
    public AppConfig AppConfig { get; set; } = default!;

    /// <summary>
    /// True si el proveedor actual requiere API Key (modelo cloud).
    /// En ese caso los timeouts locales se ocultan porque la latencia
    /// la gestiona el proveedor.
    /// </summary>
    private bool IsCloudProvider =>
        LlmProviderHelper.RequiresApiKey(LlmProviderHelper.ParseProvider(AppConfig.Provider));
}
