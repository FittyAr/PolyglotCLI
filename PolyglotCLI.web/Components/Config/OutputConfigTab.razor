<RadzenRow Gap="1rem" class="rz-mb-4">
    <RadzenColumn Size="12">
        <RadzenCheckBox @bind-Value="AppConfig.SaveMarkdown" Name="cfgSaveMd" />
        <RadzenLabel Text="@L["Config.AlwaysSaveMarkdown"]" Component="cfgSaveMd" class="rz-ml-2" />
    </RadzenColumn>
</RadzenRow>
<RadzenRow Gap="1rem" class="rz-mb-4">
    <RadzenColumn Size="12">
        <RadzenLabel Text="@L["Config.DefaultOutputFormat"]" class="rz-mb-2" />
        <RadzenDropDown @bind-Value="AppConfig.DefaultOutputFormat" Data="@OutputFormatOptions" class="rz-w-100" Placeholder="@L["Config.None"]" AllowClear="true" />
        <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-2" style="color: #b0bec5; display: block;">@L["Config.OutputFormatsNote"]</RadzenText>
    </RadzenColumn>
</RadzenRow>
<RadzenRow Gap="1rem" class="rz-mb-4">
    <RadzenColumn Size="12">
        <RadzenLabel Text="@L["Config.SupportedOutputFormats"]" class="rz-mb-2" />
        <RadzenTextBox Value="@OutputFormatsInput" ValueChanged="@OnOutputFormatsInputChanged" class="rz-w-100" />
    </RadzenColumn>
</RadzenRow>
<RadzenRow Gap="1rem" class="rz-mb-4">
    <RadzenColumn Size="12">
        <RadzenLabel Text="@L["Config.SupportedInputExtensions"]" class="rz-mb-2" />
        <RadzenTextBox Value="@InputExtensionsInput" ValueChanged="@OnInputExtensionsInputChanged" class="rz-w-100" />
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter]
    public PolyglotCLI.AppConfig AppConfig { get; set; } = default!;

    [Parameter]
    public List<string> OutputFormatOptions { get; set; } = new();

    [Parameter]
    public string OutputFormatsInput { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OutputFormatsInputChanged { get; set; }

    [Parameter]
    public string InputExtensionsInput { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> InputExtensionsInputChanged { get; set; }

    private async Task OnOutputFormatsInputChanged(string val)
    {
        await OutputFormatsInputChanged.InvokeAsync(val);
    }

    private async Task OnInputExtensionsInputChanged(string val)
    {
        await InputExtensionsInputChanged.InvokeAsync(val);
    }
}
