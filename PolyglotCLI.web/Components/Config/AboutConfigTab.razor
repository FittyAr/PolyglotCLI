                    </tr>
                    <tr>
                        <td style="opacity: 0.7;">Target Framework</td>
                        <td><code>@TargetFramework</code></td>
                    </tr>
                    <tr>
                        <td style="opacity: 0.7;">.NET Runtime</td>
                        <td><code>@RuntimeVersion</code></td>
                    </tr>
                    <tr>
