@code {
    private string AppVersion { get; } = ResolveAppVersion();







    private string? GitCommitShort { get; } = ResolveGitCommitShort();







    private string TargetFramework { get; } = ResolveTargetFramework();







    private string RuntimeVersion { get; } = Environment.Version.ToString();







    private string BuildDate { get; } = ResolveBuildDate();







    private string LicenseText { get; } = DefaultLicenseText;















    // --- Estado de actualizaciones ---







    private bool _checking;







    private UpdateInfo? _updateInfo;







    private string LastCheckDisplay =>







    _updateInfo is null







    ? "Nunca"







    : (_updateInfo.CheckSucceeded ? "OK" : $"Error: {_updateInfo.ErrorMessage}");







    private string LatestVersionDisplay =>







    _updateInfo is null || !_updateInfo.CheckSucceeded ? string.Empty : _updateInfo.LatestVersion;







    private bool IsUpdateAvailable =>







    _updateInfo is { CheckSucceeded: true, IsUpdateAvailable: true };















    private UpdateHostedService? _updater;















    protected override void OnInitialized()







    {







        // Solo resolvemos el servicio si la app puede auto-actualizarse







        // (es decir, no es MSIX). En MSIX el campo sale deshabilitado.







        if (InstallEnvironment.CanSelfUpdate)







        {







            try







            {







                var hosted = (IEnumerable<Microsoft.Extensions.Hosting.IHostedService>?)Services







                .GetService(typeof(IEnumerable<Microsoft.Extensions.Hosting.IHostedService>));







                _updater = hosted?.FirstOrDefault(s => s is UpdateHostedService) as UpdateHostedService;







                if (_updater?.LastCheck is UpdateInfo last)







                {







                    _updateInfo = last;







                }







            }







            catch







            {







                // Si falla la resolución, el botón seguirá funcionando







                // porque OnCheckClick también resuelve el servicio.







            }







        }







    }















    private async Task OnCheckClick()







    {







        if (_checking) return;







        _checking = true;







        try







        {







            // Re-resolver por si el servicio no estaba disponible en







            // OnInitialized (p.ej. la pestaña se montó antes que el host).







            if (_updater is null)







            {







                var hosted = (IEnumerable<Microsoft.Extensions.Hosting.IHostedService>?)Services







                .GetService(typeof(IEnumerable<Microsoft.Extensions.Hosting.IHostedService>));







                _updater = hosted?.FirstOrDefault(s => s is UpdateHostedService) as UpdateHostedService;







            }







            if (_updater is null)







            {







                Notifier.Notify(NotificationSeverity.Warning,







                "Servicio de updates no disponible",







                "Esta instalación no soporta auto-actualización.",







                duration: 6000);







                return;







            }















            var info = await _updater.CheckNowAsync();







            _updateInfo = info;







            if (info.CheckSucceeded && info.IsUpdateAvailable)







            {







                // Reusar el dialog del notifier







                var result = await DialogService.OpenAsync<UpdateAvailableDialog>(







                title: $"Actualización disponible: {info.LatestVersion}",







                parameters: new Dictionary<string, object?> { { "Info", info } },







                options: new DialogOptions { Width = "560px" });







                if (string.Equals(result as string, "dismiss", StringComparison.OrdinalIgnoreCase))







                {







                    _updater.DismissUpdate(info.LatestVersion);







                }







            }







            else if (info.CheckSucceeded)







            {







                Notifier.Notify(NotificationSeverity.Success,







                "Sin actualizaciones",







                $"Ya tenés la última versión ({info.CurrentVersion}).",







                duration: 5000);







            }







            else







            {







                Notifier.Notify(NotificationSeverity.Error,







                "No se pudo consultar GitHub",







                info.ErrorMessage,







                duration: 7000);







            }







        }







        finally







        {







            _checking = false;







        }







    }















    /// <summary>
    /// Versión del ensamblado: combina el archivo AssemblyInformationalVersionAttribute
    /// (formato "1.1.2+abcdef") cuando está disponible, y cae al
    /// AssemblyVersion si falta. Sin reflexión, una cadena vacía.
    /// </summary>
    private static string ResolveAppVersion()







    {







        var asm = typeof(AboutConfigTab).Assembly;







        var info = asm.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;







        if (!string.IsNullOrWhiteSpace(info))







        {







            // "1.1.2+abcdef..." -> mostramos sólo el hash corto aparte







            var plusIdx = info.IndexOf('+');







            if (plusIdx > 0)







            {







                return info[..plusIdx];







            }







            return info;







        }







        return asm.GetName().Version?.ToString() ?? "1.0.0";







    }















    private static string? ResolveGitCommitShort()







    {







        var asm = typeof(AboutConfigTab).Assembly;







        var info = asm.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;







        if (!string.IsNullOrWhiteSpace(info))







        {







            var plusIdx = info.IndexOf('+');







            if (plusIdx > 0 && plusIdx + 1 < info.Length)







            {







                var hash = info[(plusIdx + 1)..];







                return hash.Length >= 7 ? hash[..7] : hash;







            }







        }







        return null;







    }















    private static string ResolveTargetFramework()







    {







        var asm = typeof(AboutConfigTab).Assembly;







        var attr = asm.GetCustomAttribute<TargetFrameworkAttribute>();







        return attr?.FrameworkName ?? "net10.0";







    }















    private static string ResolveBuildDate()







    {







        // La fecha de compilación no es trivial sin MSBuild; usamos la del







        // ensamblado (WriteTime del PE header) cuando está disponible, y







        // caemos a la del directorio de la app en single-file publish.







        try







        {







            var asm = typeof(AboutConfigTab).Assembly;







            var location = asm.Location;







            if (!string.IsNullOrEmpty(location) && System.IO.File.Exists(location))







            {







                return System.IO.File.GetLastWriteTime(location).ToString("yyyy-MM-dd HH:mm");







            }







            // En single-file publish asm.Location es vacío; usamos el







            // directorio base de la app como proxy razonable.







            var baseDir = AppContext.BaseDirectory;







            if (!string.IsNullOrEmpty(baseDir))







            {







                var probe = System.IO.Path.Combine(baseDir, asm.GetName().Name + ".dll");







                if (System.IO.File.Exists(probe))







                {







                    return System.IO.File.GetLastWriteTime(probe).ToString("yyyy-MM-dd HH:mm");







                }







            }







        }







        catch







        {







            // Si nada funciona, mostramos la fecha actual como último recurso.







        }







        return DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") + " UTC";







    }















