                <tbody>
                    <tr>
                        <td style="opacity: 0.7; width: 30%; vertical-align: top; padding-top: 0.6rem;">
                            @L["About.PathConfig"]
                            <div style="opacity: 0.6; font-size: 0.78em;">config.json</div>
                        </td>
                        <td>
                            <code style="word-break: break-all; user-select: all;">@ConfigPath</code>
                            <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light"
