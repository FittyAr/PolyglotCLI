    // ─── Ubicaciones de archivos ───────────────────────────────────
    // Estos getters resuelven los paths tal como los usa la app en
    // esta corrida (no los defaults de la doc). Si cambiás el
    // OutputDirectory o LogDirectory en la config, los valores de
    // acá se actualizan al refrescar la pestaña.

    private string ConfigPath =>
        !string.IsNullOrEmpty(AppConfig?.LoadedFromPath)
            ? AppConfig.LoadedFromPath
            : AppConfig.GetDefaultConfigPath();

    private string? _cachedPromptsPath;
    private string PromptsPath =>
        _cachedPromptsPath ??= new PromptLoader().PromptsDirectory;

    private string LogsPath
    {
        get
        {
            if (AppConfig == null || string.IsNullOrEmpty(AppConfig.LogDirectory))
                return string.Empty;
            if (OperatingSystem.IsWindows())
            {
                // Estructura {desarrollador}\{programa}: debe matchear
                // exactamente el path que usa AppLogger.Initialize
                // (AppConfig.cs/AppLogger.cs). Si esto se desincroniza,
                // el botón "Copiar" lleva al user a un directorio
                // que no existe.
                string appData = Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData);
                return Path.Combine(appData, "FittyAr", "PolyglotCLI", AppConfig.LogDirectory);
            }
            return Path.Combine(AppContext.BaseDirectory, AppConfig.LogDirectory);
        }
    }

    private string OutputPath =>
        AppConfig?.AbsoluteOutputDirectory ?? string.Empty;

    private string JobsPath => TranslationOrchestrator.GetJobsDirectory();

    /// <summary>
    /// Copia un path al portapapeles del navegador. El callback puede
    /// fallar si la pestaña no tiene foco o si el browser bloquea
    /// el acceso programático al clipboard — en ese caso la
    /// notificación informa y el path sigue visible en pantalla para
    /// que el usuario lo seleccione a mano.
    /// </summary>
    private async Task CopyToClipboard(string? text, string label)
    {
        if (string.IsNullOrEmpty(text))
        {
            Notifier.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Path vacío",
                Detail = $"No hay un path de {label} para copiar.",
                Duration = 3000
            });
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Notifier.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"{label} copiado al portapapeles",
                Detail = text,
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            // El browser suele bloquear el acceso cuando la pestaña
            // no tiene foco o si el usuario denegó permisos. No es
            // un error real: el path sigue visible en pantalla.
            Notifier.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "No se pudo copiar automáticamente",
                Detail = $"Seleccioná el path manualmente. ({ex.GetType().Name})",
                Duration = 4000
            });
        }
    }
