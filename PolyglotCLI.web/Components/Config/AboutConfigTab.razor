@using System.Reflection
@using System.Runtime.Versioning
@using Microsoft.JSInterop
@using PolyglotCLI.Update
@using PolyglotCLI.web.Services
@inject IServiceProvider Services
@inject NotificationService Notifier
@inject DialogService DialogService
@inject IJSRuntime JS
@inject PolyglotCLI.AppConfig AppConfig

@*
Pestaña "About": muestra información del proyecto PolyglotCLI
(versión, licencia, desarrollador, stack tecnológico) y expone
el control manual de actualizaciones (solo en instalaciones
Inno Setup / .exe).
*@

<RadzenRow Gap="1.5rem">
    <!-- Columna izquierda: identidad del proyecto -->
    <RadzenColumn Size="12" SizeMD="5">
        <RadzenFieldset Text="PolyglotCLI" class="rz-mt-2">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                <img src="brand-logo.png" alt="@L["About.LogoAlt"]"
                    style="width: 64px; height: 64px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.25);" />
                <div>
                    <RadzenText TextStyle="TextStyle.H5" style="margin: 0;">PolyglotCLI</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" style="opacity: 0.75;">
                        @L["About.Tagline"]
                    </RadzenText>
                </div>
            </div>

            <RadzenText TextStyle="TextStyle.Body2" style="margin-bottom: 0.75rem;">
                @L["About.Description"]
            </RadzenText>

            <table class="rz-grid-table rz-w-100" style="font-size: 0.9rem;">
                <tbody>
                    <tr>
                        <td style="opacity: 0.7; width: 40%;">@L["About.Version"]</td>
                        <td>
                            <code>@AppVersion</code>
                            @if (!string.IsNullOrEmpty(GitCommitShort))
                            {
                                <span style="opacity: 0.6; margin-left: 0.4rem;">(@GitCommitShort)</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td style="opacity: 0.7;">@L["About.TargetFramework"]</td>
                        <td><code>@TargetFramework</code></td>
                    </tr>
                    <tr>
                        <td style="opacity: 0.7;">@L["About.DotNetRuntime"]</td>
                        <td><code>@RuntimeVersion</code></td>
                    </tr>
                    <tr>
                        <td style="opacity: 0.7;">@L["About.BuildDate"]</td>
                        <td><code>@BuildDate</code></td>
                    </tr>
                </tbody>
            </table>
        </RadzenFieldset>

        <RadzenFieldset Text="@L["About.Developer"]" class="rz-mt-4">
            <table class="rz-grid-table rz-w-100" style="font-size: 0.9rem;">
                <tbody>
                    <tr>
                        <td style="opacity: 0.7; width: 40%;">@L["About.Author"]</td>
                        <td>
                            <a href="https://fitty.ar" target="_blank" rel="noopener"
                                style="color: var(--rz-primary); text-decoration: none;">
                                FittyAr
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td style="opacity: 0.7;">@L["About.ProjectSite"]</td>
                        <td>
                            <a href="https://fitty.ar/pages/polyglot-cli.html" target="_blank" rel="noopener"
                                style="color: var(--rz-primary); text-decoration: none;">
                                fitty.ar/pages/polyglot-cli.html
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td style="opacity: 0.7;">@L["About.Repository"]</td>
                        <td>
                            <a href="https://github.com/FittyAr/PolyglotCLI" target="_blank" rel="noopener"
                                style="color: var(--rz-primary); text-decoration: none;">
                                github.com/FittyAr/PolyglotCLI
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td style="opacity: 0.7;">@L["About.Copyright"]</td>
                        <td>@L["About.CopyrightNotice"]</td>
                    </tr>
                </tbody>
            </table>
        </RadzenFieldset>

        <RadzenFieldset Text="@L["About.License"]" class="rz-mt-4">
            <RadzenText TextStyle="TextStyle.Body2" style="margin-bottom: 0.5rem;">
                @L["About.LicenseIntroPrefix"] <strong>MIT License</strong>@L["About.LicenseIntroSuffix"]
            </RadzenText>
            <pre style="background: rgba(0,0,0,0.15); padding: 0.75rem; border-radius: 6px;
                        font-size: 0.75rem; max-height: 180px; overflow: auto; white-space: pre-wrap;
                        font-family: monospace; margin: 0;">@LicenseText</pre>
        </RadzenFieldset>
    </RadzenColumn>

    <!-- Columna derecha: stack y créditos -->
