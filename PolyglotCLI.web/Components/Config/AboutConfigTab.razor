        @* El aviso "Hecho con ❤" se renderiza en el footer del
           MainLayout (visible en todas las páginas), con estilo
           discreto. No va acá dentro para no repetir la misma
           copy dos veces. *@

        <RadzenFieldset Text="@L["About.Updates"]" class="rz-mt-4">
            @* La UI de updates es responsabilidad de UpdateNotifier; este
            bloque solo muestra el estado actual y permite forzar un
            check manual. *@
            <table class="rz-grid-table rz-w-100" style="font-size: 0.9rem;">
                <tbody>
                    <tr>
                        <td style="opacity: 0.7; width: 35%;">@L["About.InstallType"]</td>
                        <td>
                            @if (InstallEnvironment.IsMsixInstalled)
