                                          class="rz-ml-2" title="@L["About.CopyPath"]" />
                        </td>
                    </tr>
                    <tr>
                        <td style="opacity: 0.7; vertical-align: top; padding-top: 0.6rem;">
                            @L["About.SystemPrompts"]
