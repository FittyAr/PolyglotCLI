@using System.Reflection
@using System.Runtime.Versioning
@using PolyglotCLI.Update
@using PolyglotCLI.web.Services
@inject IServiceProvider Services
@inject NotificationService Notifier
@inject DialogService DialogService

@*
Pestaña "About": muestra información del proyecto PolyglotCLI
(versión, licencia, desarrollador, stack tecnológico) y expone
el control manual de actualizaciones (solo en instalaciones
Inno Setup / .exe).
*@

