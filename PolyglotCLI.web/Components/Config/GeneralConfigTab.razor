@using PolyglotCLI
@inject DialogService DialogService

@*
    Pestaña "General": configuración esencial del proveedor LLM y de la
    aplicación. Lo avanzado (timeouts, logs, módulos) vive en
    AdvancedConfigTab.

    Al cambiar el Proveedor LLM, se abre un dialog preguntando si se
    quiere replicar el cambio a OCR / Translation / Revision. Si el
    usuario cancela, el dropdown vuelve a su valor anterior y no se
    modifica nada.
*@

<RadzenRow Gap="1rem" class="rz-mb-4">
    <RadzenColumn Size="6">
        <RadzenLabel Text="Proveedor LLM" class="rz-mb-2" />
        <RadzenDropDown Data="@providerOptions"
                        Value="@AppConfig.Provider"
                        Change="@OnProviderChanged"
                        AllowClear="false"
                        class="rz-w-100" />
    </RadzenColumn>
    <RadzenColumn Size="6">
        <RadzenLabel Text="API Key" class="rz-mb-2" />
        @*
            Nunca mostramos la API Key en claro. Si ya hay una
            guardada, renderizamos solo su versión enmascarada
            (primeros 5 + … + últimos 5) y dejamos un input aparte
            para que el usuario ingrese la nueva (vacío por default
            = "no la cambio"). El botón "Eliminar" borra la key
            persistida sin pedir reemplazo.
        *@
        @if (!string.IsNullOrEmpty(AppConfig.ApiKey))
        {
            <div class="api-key-display rz-mb-2"
                 style="display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem; background: var(--rz-input-background-color); border: 1px solid var(--rz-border-color); border-radius: 4px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9em;">
                <span title="API Key almacenada (enmascarada)">@MaskedApiKey</span>
                <RadzenButton Icon="delete_outline"
                              ButtonStyle="ButtonStyle.Danger"
                              Variant="Variant.Text"
                              Size="ButtonSize.Small"
                              Click="@ClearApiKey"
                              Disabled="@(!IsCloudProvider)"
                              title="Eliminar API Key almacenada"
                              class="rz-ml-auto" />
            </div>
        }
        <RadzenTextBox @bind-Value="newApiKey"
                       Placeholder="@ApiKeyPlaceholder"
                       Disabled="@(!IsCloudProvider)"
                       autocomplete="off"
                       spellcheck="false"
                       class="rz-w-100" />
    </RadzenColumn>
</RadzenRow>

<RadzenRow Gap="1rem" class="rz-mb-4">
    <RadzenColumn Size="12">
        <RadzenLabel Text="URL Base de la API" class="rz-mb-2" />
        <div style="display: flex; gap: 0.5rem;">
            <RadzenTextBox @bind-Value="AppConfig.ApiUrl" style="flex-grow: 1;" />
            <RadzenButton Text="Probar Conexión" Icon="sync" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(async () => await OnTestConnection.InvokeAsync())"
                          IsBusy="@IsTestingConnection" BusyText="Conectando..." />
        </div>
    </RadzenColumn>
</RadzenRow>

<RadzenRow Gap="1rem" class="rz-mb-4">
    <RadzenColumn Size="8">
        <RadzenLabel Text="Directorio de Salida" class="rz-mb-2" />
        <RadzenTextBox @bind-Value="AppConfig.OutputDirectory" class="rz-w-100" />
    </RadzenColumn>
    <RadzenColumn Size="4" class="rz-align-self-end rz-pb-1">
        <RadzenCheckBox @bind-Value="AppConfig.Debug" Name="cfgDebug" />
        <RadzenLabel Text="Modo Debug (2 primeras pág.)" Component="cfgDebug" class="rz-ml-2" />
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter]
    public AppConfig AppConfig { get; set; } = default!;

    [Parameter]
    public bool IsTestingConnection { get; set; }

    [Parameter]
    public EventCallback OnTestConnection { get; set; }

    private List<string> providerOptions = new List<string>
    {
        "Ollama",
        "LmStudio",
        "LlamaCpp",
        "OpenAi",
        "Gemini",
        "Qwen",
        "Kimi",
        "MiniMax",
        "Custom"
    };

    /// <summary>
    /// True si el proveedor actual requiere API Key (modelo cloud).
    /// </summary>
    private bool IsCloudProvider =>
        LlmProviderHelper.RequiresApiKey(LlmProviderHelper.ParseProvider(AppConfig.Provider));

    /// <summary>
    /// Estado del input "nueva API Key". Vive solo en este componente;
    /// si el usuario lo deja vacío al guardar, se conserva la API Key
    /// ya persistida. Esto evita que el campo muestre la key en claro
    /// (seguridad) y permite al usuario reemplazarla sin ver la
    /// anterior completa.
    /// </summary>
    private string? newApiKey;

    /// <summary>
    /// Versión enmascarada de la API Key persistida, lista para
    /// mostrar al usuario (primeros 5 + … + últimos 5).
    /// </summary>
    private string MaskedApiKey => SecureField.Mask(AppConfig.ApiKey);

    /// <summary>
    /// Placeholder del input: distinto según haya o no una key
    /// persistida, para que el usuario sepa qué va a pasar si deja
    /// el campo vacío.
    /// </summary>
    private string ApiKeyPlaceholder
    {
        get
        {
            if (!IsCloudProvider) return "No requerida para proveedores locales";
            return string.IsNullOrEmpty(AppConfig.ApiKey)
                ? "sk-..."
                : "Ingresá una nueva API Key para reemplazar la actual";
        }
    }

    /// <summary>
    /// Borra la API Key persistida (botón "Eliminar" del display
    /// enmascarado). Marca el AppConfig como dirty para que el
    /// siguiente Save persista el cambio.
    /// </summary>
    private void ClearApiKey()
    {
        AppConfig.ApiKey = null;
        newApiKey = null;
    }

    /// <summary>
    /// Aplica la nueva API Key al <see cref="AppConfig"/> si el
    /// usuario escribió algo. Lo llama el padre (Config.razor) justo
    /// antes de <c>AppConfig.Save()</c>. Devuelve true si hubo un
    /// cambio real.
    /// </summary>
    public bool ApplyToConfig()
    {
        if (string.IsNullOrWhiteSpace(newApiKey)) return false;
        AppConfig.ApiKey = newApiKey.Trim();
        newApiKey = null;
        return true;
    }

    /// <summary>
    /// True si el usuario escribió una nueva key en el input pero
    /// todavía no guardó. El padre lo usa para el dirty tracking
    /// (para que el modal de "cambios sin guardar" se dispare).
    /// </summary>
    public bool HasPendingNewKey => !string.IsNullOrWhiteSpace(newApiKey);

    /// <summary>
    /// Descarta el cambio pendiente (usado cuando el usuario elige
    /// "Descartar" en el modal de cambios sin guardar).
    /// </summary>
    public void DiscardPendingChange()
    {
        newApiKey = null;
    }

    /// <summary>
    /// Maneja el cambio del dropdown de Proveedor LLM. NO muta
    /// AppConfig.Provider directamente: primero abre el dialog
    /// preguntando si se replica a OCR/Translation/Revision. Si el
    /// usuario cancela, el dropdown vuelve a su valor anterior
    /// automáticamente (porque usamos Value + Change en lugar de
    /// @bind-Value, y nunca escribimos AppConfig.Provider en ese caso).
    /// </summary>
    private async Task OnProviderChanged(object value)
    {
        if (value is not string providerStr || string.IsNullOrWhiteSpace(providerStr))
            return;

        var previousProvider = AppConfig.Provider;

        var result = await DialogService.OpenAsync<ProviderCascadeDialog>(
            title: "Replicar proveedor",
            parameters: new Dictionary<string, object?>
            {
                { "NewProvider",        providerStr            },
                { "CurrentOcr",         AppConfig.OcrProvider   },
                { "CurrentTranslation", AppConfig.TranslationProvider },
                { "CurrentReview",      AppConfig.ReviewProvider }
            },
            options: new DialogOptions
            {
                Width = "500px",
                CloseDialogOnEsc = true,
                CloseDialogOnOverlayClick = false
            });

        if (result is ProviderCascadeDialog.Result r)
        {
            // Confirmado: aplicar el provider nuevo y la API URL por defecto
            AppConfig.Provider = providerStr;
            var provider = LlmProviderHelper.ParseProvider(providerStr);
            AppConfig.ApiUrl = LlmProviderHelper.GetDefaultApiUrl(provider);

            // Replicar a las secciones que el usuario tildó
            if (r.ApplyToOcr)         AppConfig.OcrProvider         = providerStr;
            if (r.ApplyToTranslation) AppConfig.TranslationProvider = providerStr;
            if (r.ApplyToReview)      AppConfig.ReviewProvider      = providerStr;
        }
        // Si r es null (cancelado / cerrado por Esc) no hacemos nada:
        // como nunca escribimos AppConfig.Provider, el dropdown conserva
        // el valor anterior sin necesidad de revertir.
    }
}

