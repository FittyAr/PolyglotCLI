<RadzenTabsItem>
    <Template>
        <div class="page-tabs-tab">
            <RadzenIcon Icon="psychology" class="page-tabs-tab__icon page-tabs-tab__icon--reasoning" />
            <span>Pensamiento</span>
        </div>
    </Template>
    <ChildContent>
        <div class="text-pane">
            <div class="text-pane__header text-pane__header--readonly">
                <span class="text-pane__mode">
                    <RadzenIcon Icon="auto_awesome" Style="font-size: 0.95rem;" />
                    Trazas del modelo (sólo lectura)
                </span>
                <span class="text-pane__counter">@(Text?.Length ?? 0) caracteres</span>
            </div>
            <div class="text-pane__body">
                @if (!string.IsNullOrEmpty(Text))
                {
                    <pre class="text-pane__preview text-pane__preview--reasoning">@Text</pre>
                }
                else
                {
                    <div class="text-pane__placeholder">
                        <RadzenIcon Icon="psychology_alt" Style="font-size: 2rem; color: #475569;" />
                        <div>No hay trazas de razonamiento (&lt;think&gt;) disponibles para esta página.</div>
                    </div>
                }
            </div>
        </div>
    </ChildContent>
</RadzenTabsItem>
