<RadzenTabsItem Text="Pensamiento (Reasoning)" Icon="psychology">
    <div style="flex: 1 1 0%; display: flex; flex-direction: column; margin-top: 6px; min-height: 0; height: 100%;">
        @if (!string.IsNullOrEmpty(Text))
        {
            <pre style="flex: 1 1 0%; margin: 0; padding: 12px; font-family: monospace; font-size: 0.9rem; color: #f59e0b; white-space: pre-wrap; background: #0b0f19; border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; height: 100%; overflow-y: auto; min-height: 0;">@Text</pre>
        }
        else
        {
            <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #b0bec5; font-size: 0.9rem; border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; background: #0b0f19; min-height: 0;">
                No hay trazas de razonamiento (&lt;think&gt;) disponibles para esta página.
            </div>
        }
    </div>
</RadzenTabsItem>
