<RadzenTabsItem>
    <Template>
        <div class="page-tabs-tab">
            <RadzenIcon Icon="translate" class="page-tabs-tab__icon page-tabs-tab__icon--translate" />
            <span>Traducción</span>
        </div>
    </Template>
    <ChildContent>
        <div class="text-pane" style="flex: 1 1 0%; min-height: 1000px; height: 100%; width: 100%; display: flex; flex-direction: column; gap: 8px;">
            <div class="text-pane__header" style="display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-shrink: 0; padding: 5px 10px; background: rgba(15, 23, 42, 0.55); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 6px;">
                <span class="text-pane__mode" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; color: #94a3b8;">
                    <RadzenIcon Icon="@(IsEditingTranslation ? "edit_note" : "visibility")" Style="font-size: 0.95rem;" />
                    @(IsEditingTranslation ? "Editando" : "Vista previa")
                </span>
                <RadzenButton Icon="@(IsEditingTranslation ? "visibility" : "edit")"
                              Text="@(IsEditingTranslation ? "Vista previa" : "Editar")"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.ExtraSmall"
                              Click="@ToggleEditing"
                              Style="margin-left: auto;" />
            </div>
            <div class="text-pane__body" style="flex: 1 1 0%; min-height: 0; height: 100%; display: flex; flex-direction: column; overflow: hidden;">
                @if (IsEditingTranslation)
                {
                    <RadzenTextArea Value="@Text"
                                    ValueChanged="@(async (string v) => await NotifyTranslationChanged(v))"
                                    class="text-pane__textarea text-pane__textarea--translate"
                                    Style="flex: 1 1 0%; min-height: 0; height: 100%; width: 100%; display: flex; flex-direction: column; font-family: monospace; font-size: 0.9rem; resize: none; padding: 12px; border-radius: 6px;" />
                }
                else
                {
                    <div class="text-pane__preview text-pane__preview--translate" style="flex: 1 1 0%; min-height: 0; height: 100%; padding: 12px; border: 1px solid rgba(129, 140, 248, 0.25); border-radius: 6px; overflow-y: auto; background: linear-gradient(180deg, #0f172a 0%, #0b1424 100%); color: #e2e8f0;">
                        @if (!string.IsNullOrWhiteSpace(Text))
                        {
                            <RadzenMarkdown Text="@GetMarkdownForPreview(Text)" />
                        }
                        else
                        {
                            <div class="text-pane__empty">Sin contenido para previsualizar.</div>
                        }
                    </div>
                }
            </div>
        </div>
    </ChildContent>
</RadzenTabsItem>
