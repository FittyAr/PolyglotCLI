<RadzenTabsItem>
    <Template>
        <div class="page-tabs-tab">
            <RadzenIcon Icon="description" class="page-tabs-tab__icon page-tabs-tab__icon--ocr" />
            <span>Texto Extraído</span>
        </div>
    </Template>
    <ChildContent>
        <div class="text-pane">
            <div class="text-pane__header text-pane__header--readonly">
                <span class="text-pane__mode">
                    <RadzenIcon Icon="subject" Style="font-size: 0.95rem;" />
                    OCR (sólo lectura)
                </span>
                <span class="text-pane__counter">@(Text?.Length ?? 0) caracteres</span>
            </div>
            <div class="text-pane__body">
                <pre class="text-pane__preview text-pane__preview--ocr">@Text</pre>
            </div>
        </div>
    </ChildContent>
</RadzenTabsItem>
