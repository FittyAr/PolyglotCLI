<RadzenText TextStyle="TextStyle.Subtitle1" class="rz-my-3" style="font-weight: bold;">@L["JobDetails.JobFiles"]</RadzenText>

<RadzenDataGrid Data="@Job.Files" TItem="JobFileManifest" AllowPaging="true" PageSize="5" class="rz-mb-4">
    <Template Context="file">
        <RadzenCard Style="padding: 1rem; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05);">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2" style="font-weight: bold;">@L["JobDetails.ProgressByPage"]</RadzenText>
            @if (file.Pages != null && file.Pages.Count > 0)
            {
                <RadzenDataGrid Data="@file.Pages" TItem="JobPageManifest" AllowPaging="false" AllowSorting="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="JobPageManifest" Property="PageNumber" Title="@L["JobDetails.ColPageChunk"]" Width="90px" TextAlign="TextAlign.Center" />

                        <RadzenDataGridColumn TItem="JobPageManifest" Title="@L["JobDetails.ColExtractionOcr"]" Width="180px">
                            <Template Context="pageItem">
                                @if (pageItem.OcrCompleted)
                                {
                                    <span style="color: #4caf50; display: inline-flex; align-items: center; gap: 4px;">
                                        <RadzenIcon Icon="check_circle" Style="color: #4caf50; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.Completed"]
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(pageItem.OcrError))
                                {
                                    <span style="color: #f44336; display: inline-flex; align-items: center; gap: 4px;" title="@pageItem.OcrError">
                                        <RadzenIcon Icon="error" Style="color: #f44336; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.Failed"]
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #ffb74d; display: inline-flex; align-items: center; gap: 4px;">
                                        <RadzenIcon Icon="hourglass_empty" Style="color: #ffb74d; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.Pending"]
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="JobPageManifest" Title="@L["JobDetails.Translation"]" Width="180px">
                            <Template Context="pageItem">
                                @if (pageItem.TranslationCompleted)
                                {
                                    <span style="color: #4caf50; display: inline-flex; align-items: center; gap: 4px;">
                                        <RadzenIcon Icon="check_circle" Style="color: #4caf50; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.Completed"]
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(pageItem.TranslationError))
                                {
                                    <span style="color: #f44336; display: inline-flex; align-items: center; gap: 4px;" title="@pageItem.TranslationError">
                                        <RadzenIcon Icon="error" Style="color: #f44336; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.Failed"]
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #ffb74d; display: inline-flex; align-items: center; gap: 4px;">
                                        <RadzenIcon Icon="hourglass_empty" Style="color: #ffb74d; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.Pending"]
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="JobPageManifest" Title="@L["JobDetails.ColReview"]" Width="180px">
                            <Template Context="pageItem">
                                @if (pageItem.ReviewCompleted)
                                {
                                    <span style="color: #4caf50; display: inline-flex; align-items: center; gap: 4px;">
                                        <RadzenIcon Icon="check_circle" Style="color: #4caf50; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.Completed"]
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(pageItem.ReviewError))
                                {
                                    <span style="color: #f44336; display: inline-flex; align-items: center; gap: 4px;" title="@pageItem.ReviewError">
                                        <RadzenIcon Icon="error" Style="color: #f44336; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.Failed"]
                                    </span>
                                }
                                else
                                {
                                    <span style="color: #ffb74d; display: inline-flex; align-items: center; gap: 4px;">
                                        <RadzenIcon Icon="hourglass_empty" Style="color: #ffb74d; font-size: 1.1rem; vertical-align: middle;" /> @L["JobDetails.PendingOrNotRequired"]
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="JobPageManifest" Title="@L["JobDetails.ColDocConversion"]" Width="180px">
                            <Template Context="pageItem">
                                <span style="@(pageItem.ConversionCompleted ? "color: #4caf50;" : "color: #b0bec5;") display: inline-flex; align-items: center; gap: 4px;">
                                    <RadzenIcon Icon="@(pageItem.ConversionCompleted ? "check_circle" : "help_outline")" Style="@((pageItem.ConversionCompleted ? "color: #4caf50;" : "color: #b0bec5;") + " font-size: 1.1rem; vertical-align: middle;")" />
                                    @(pageItem.ConversionCompleted ? L["JobDetails.Completed"] : L["JobDetails.PendingOrNotRequired"])
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                <span style="color: #b0bec5;">@L["JobDetails.NoPagesYet"]</span>
            }
        </RadzenCard>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="JobFileManifest" Property="OriginalFileName" Title="@L["JobDetails.ColOriginalFileName"]" />
        <RadzenDataGridColumn TItem="JobFileManifest" Property="Completed" Title="@L["JobDetails.ColFileStatus"]" Width="130px" TextAlign="TextAlign.Center">
            <Template Context="file">
                <RadzenBadge BadgeStyle="@(file.Completed ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@(file.Completed ? L["JobDetails.Completed"] : L["JobDetails.Incomplete"])" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="JobFileManifest" Property="Pages.Count" Title="@L["JobDetails.ColTotalPages"]" Width="160px" TextAlign="TextAlign.Center" />
    </Columns>
</RadzenDataGrid>
