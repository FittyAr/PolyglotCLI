<RadzenTabsItem Text="Original (PDF / Imagen)" Icon="image">
    <div class="original-viewer-host">
        @if (HasPageImage && !string.IsNullOrEmpty(PageImageBase64))
        {
            <div class="original-viewer-toolbar">
                <RadzenButton Icon="zoom_in" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" Click="@HandleZoomIn" Title="Acercar" Disabled="@(!IsPanzoomInteractive)" />
                <RadzenButton Icon="zoom_out" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" Click="@HandleZoomOut" Title="Alejar" Disabled="@(!IsPanzoomInteractive)" />
                <RadzenButton Icon="restart_alt" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall" Click="@HandleReset" Title="Restablecer" Disabled="@(!IsPanzoomInteractive)" />
                <span class="original-viewer-hint">Arrastra · Rueda · Doble clic</span>
            </div>
            <div class="original-viewer-stage">
                <Panzoom @ref="panzoomRef"
                         PanzoomOptions="panzoomOptions"
                         WheelMode="WheelMode.ZoomWithWheel">
                    <div @ref="@context.ElementReference" class="polyglot-panzoom-wrapper">
                        <img src="@PageImageDataUrl"
                             alt="Página @PageNumber"
                             class="polyglot-panzoom-image"
                             draggable="false"
                             @onload="OnImageLoaded" />
                    </div>
                </Panzoom>
            </div>
        }
        else
        {
            <div class="original-viewer-empty">
                No hay imagen renderizada disponible para este tipo de documento.
            </div>
        }
    </div>
</RadzenTabsItem>
