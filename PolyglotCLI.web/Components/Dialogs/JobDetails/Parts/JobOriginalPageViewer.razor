@using Cropper.Blazor.Components
@using Cropper.Blazor.Models

<RadzenTabsItem Text="Original (PDF / Imagen)" Icon="image">
    <div class="original-viewer-host">
        @if (HasPageImage && !string.IsNullOrEmpty(PageImageBase64))
        {
            <div class="original-viewer-toolbar">
                <RadzenButton Icon="zoom_in" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" Click="@HandleZoomIn" Title="Acercar" Disabled="@(!IsCropperInteractive)" />
                <RadzenButton Icon="zoom_out" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" Click="@HandleZoomOut" Title="Alejar" Disabled="@(!IsCropperInteractive)" />
                <RadzenButton Icon="restart_alt" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall" Click="@HandleReset" Title="Restablecer" Disabled="@(!IsCropperInteractive)" />
                <span class="original-viewer-hint">Arrastra · Rueda · Doble clic</span>
            </div>
            <div class="original-viewer-stage">
                <CropperComponent @ref="cropperRef"
                                 Src="@PageImageDataUrl"
                                 Options="cropperOptions"
                                 Class="polyglot-cropper"
                                 IsAvailableInitCropper="false"
                                 OnReadyEvent="OnCropperReady"
                                 OnLoadImageEvent="HandleImageLoaded" />
            </div>
        }
        else
        {
            <div class="original-viewer-empty">
                No hay imagen renderizada disponible para este tipo de documento.
            </div>
        }
    </div>
</RadzenTabsItem>