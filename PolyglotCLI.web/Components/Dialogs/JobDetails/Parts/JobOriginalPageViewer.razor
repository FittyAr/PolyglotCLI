<RadzenTabsItem Text="@L["JobDetails.OriginalTab"]" Icon="image">
    <div class="original-viewer-host">
        @if (HasPageImage && !string.IsNullOrEmpty(PageImageBase64))
        {
            <div class="original-viewer-toolbar">
                <RadzenButton Icon="zoom_in" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" Click="@HandleZoomIn" Title="@L["JobDetails.ZoomIn"]" Disabled="@(!IsPanzoomInteractive)" />
                <RadzenButton Icon="zoom_out" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" Click="@HandleZoomOut" Title="@L["JobDetails.ZoomOut"]" Disabled="@(!IsPanzoomInteractive)" />
                <RadzenButton Icon="restart_alt" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall" Click="@HandleReset" Title="@L["JobDetails.ResetZoom"]" Disabled="@(!IsPanzoomInteractive)" />
                <span class="original-viewer-hint">@L["JobDetails.ViewerHint"]</span>
            </div>
            <div class="original-viewer-stage">
                <Panzoom @ref="panzoomRef"
                         PanzoomOptions="panzoomOptions"
                         WheelMode="WheelMode.ZoomWithWheel">
                    <div @ref="@context.ElementReference" class="polyglot-panzoom-wrapper">
                        <img src="@PageImageDataUrl"
                             alt="@(L["JobDetails.PageAlt", PageNumber])"
                             class="polyglot-panzoom-image"
                             draggable="false"
                             @onload="OnImageLoaded" />
                    </div>
                </Panzoom>
            </div>
        }
        else
        {
            <div class="original-viewer-empty">
                @L["JobDetails.NoRenderedImage"]
            </div>
        }
    </div>
</RadzenTabsItem>
