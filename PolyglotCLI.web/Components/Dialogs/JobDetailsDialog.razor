@inject DialogService DialogService

<div class="job-details-dialog-content">
    <JobDetailsOverviewPanel Job="@State.Job" @bind-IsDetailsCollapsed="State.IsDetailsCollapsed" />

    <RadzenTabs RenderMode="TabRenderMode.Client" class="rz-m-0" Style="flex: 1 1 0%; display: flex; flex-direction: column; min-height: 0;">
        <Tabs>
            <RadzenTabsItem Text="Resumen y Progreso" Icon="assignment">
                <JobFilesSummaryTab Job="@State.Job" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Verificador de Páginas " Icon="find_in_page">
                <JobPageVerifierTab Job="@State.Job" JobDir="@State.JobDir" PendingTranslationEdits="@State.PendingTranslationEdits" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Archivos Generados (.md / .docx)" Icon="folder_open">
                <JobGeneratedFilesTab JobDir="@State.JobDir" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Imágenes Extraídas (PDF)" Icon="image">
                <JobExtractedImagesTab JobDir="@State.JobDir" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Bitácora de Logs" Icon="article">
                <JobLogsTab JobDir="@State.JobDir" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

    <div class="job-details-dialog-footer">
        <RadzenButton Text="Cerrar" Click="@(() => DialogService.Close())" ButtonStyle="ButtonStyle.Secondary" />
    </div>
</div>
