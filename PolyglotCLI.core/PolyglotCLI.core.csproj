<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.11.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Map" Version="2.0.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="HtmlToOpenXml.dll" Version="3.5.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PeachPDF" Version="0.10.1" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.82.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.82.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.82.0-alpha" />
    <!--
      Cifrado de API keys en config.json mediante DPAPI de Windows
      (CurrentUser scope: la clave solo la puede descifrar el mismo
      usuario en la misma máquina). En macOS/Linux usa los equivalentes
      nativos del paquete (Keychain / libsecret).
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

</Project>
